#export JAEGER_SERVICE_NAME="SCI-Backend"
function die()
{
    echo $1
    exit -1
}

function wait_vm_status()
{
    local vm_ID=$1
    local status=$2
    # wait for 30 seconds
    for i in {1..60}; do
        local state=$(virsh domstate $vm_ID | sed 's/shut off/shut_off/g')
        [ "$state" = "$status" ] && break
        sleep 0.5
    done
}

function inet_aton()
{
    ip="$1"
    hex=`printf '%02x' ${ip//./ }`
    printf "%lu\n" "0x${hex}"
}

function inet_ntoa()
{
    num="$1"
    hex=`printf "%08x\n" ${num}`
    for i in `echo ${hex} | sed "s/\(..\)/\1 /g"`; do
        printf '%hu.' "0x${i}"
    done | sed "s/\.$//g"
}

function get_tunip()
{
	tunip=$(ifconfig $vxlan_interface | grep 'inet addr' | cut -d: -f2 | cut -d' ' -f1)
	echo "tunip=$tunip" >> $localrc
}

function apply_fw()
{
    action=$1
    chain=$2
    shift
    shift
    rule=$*
    if [ "$action" = '-I' -o "$action" = '-A' ]; then
        rule_no=""
        [ "$chain" = "FORWARD" ] && rule_no=3
        [ "$chain" = "INPUT" ] && rule_no=2
        iptables -C $chain $rule 2>/dev/null || iptables $action $chain $rule_no $rule
        return
    elif [ "$action" = '-N' ]; then
        iptables -S $chain || iptables -N $chain
    fi
    iptables $action $chain $rule 2>/dev/null || true
}

function apply_vnic()
{
    action=$1
    vnic=$2
    apply_fw $action FORWARD -m physdev --physdev-in $vnic --physdev-is-bridged -j ACCEPT
    apply_fw $action FORWARD -m physdev --physdev-out $vnic --physdev-is-bridged -j ACCEPT
}

function apply_bridge()
{
    action=$1
    mybr=$2
    apply_fw $action FORWARD -i $mybr -o $mybr -j ACCEPT
}

function sync_target()
{
    target=$1
    node=$2
    cd $deploy_dir
    group=hyper
    if [ -n "$node" ]; then
        group=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    fi
    ansible $group -u cland -b -a "chown -R cland.cland $target"
    ansible $group -u cland -m synchronize -a "src=$target dest=$target"
    cd -
}

function copy_target()
{
    target=$1
    node=$2
    cd $deploy_dir
    [ -n "$node" ] && hyper_node=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    scp -i $cland_private_key -o StrictHostKeyChecking=no -r ${target} cland@${hyper_node}:${target}
    cd -
}

function action_target()
{
    node=$1
    command=$2
    cd $deploy_dir
    [ -n "$node" ] && hyper_node=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    ssh -i $cland_private_key -o StrictHostKeyChecking=no cland@$hyper_node "$command"
    cd -
}

function sql_exec()
{
    if [ ! -f $vxlan_db ]; then
        mkdir /opt/cloudland/db
        touch $vxlan_db
        sqlite3 $vxlan_db "CREATE TABLE vxlan_rules (id INTEGER PRIMARY KEY AUTOINCREMENT, instance varchar(32), vni INTEGER, inner_ip varchar(32), inner_mac varchar(48), outer_ip varchar(32))"
    fi
    sqlite3 $vxlan_db "$*"
}

function get_wds_token()
{
    [ -z "$wds_token" ] && wds_token="bearer $(curl -L -XPOST -k "$wds_address/api/v1/login" -H "Content-Type: application/json" -d "{\"name\": \"$wds_admin\",\"password\": \"$wds_pass\"}" | jq -r .access_token)"
}

function wds_curl()
{
    action=$1
    path=$2
    data=$3
    [ -z "$data" ] && data='{}'
    get_wds_token
    curl -s -L -X$action -H 'Content-Type: application/json' -H "Authorization: $wds_token" -k "$wds_address/$path" -d "$data"
    echo
}

# v3 needs Region/Az. Curl outputs the body; a trailing echo would mask its status.
function wds_curl_v3()
{
    local action=$1
    local path=$2
    local data=${3:-}
    [ -z "$data" ] && data='{}'
    get_wds_token
    curl -s -L -X"$action" -H 'Content-Type: application/json' \
        -H "Authorization: $wds_token" -H "Region: $wds_region" -H "Az: $wds_az" \
        -k "$wds_address/$path" -d "$data"
}

# Select by the real clone count; stdout contains only the resulting JSON.
function wds_get_image_snapshot()
{
    local image_volume_id=$1
    local image_prefix=$2
    log_debug "$image_volume_id" "wds_get_image_snapshot: start image_prefix=$image_prefix region=$wds_region az=$wds_az"

    # 1. Read the latest two entries after confirming the query succeeded.
    local latest_ret code latest_snapshots latest_snapshot latest_name
    if ! latest_ret=$(wds_curl_v3 GET "manager/block/v3/volume/$image_volume_id/snap?status=CREATE_SUCCESS&current_page=1&page_size=2&sort_by=create_time&order=descend"); then
        log_debug "$image_volume_id" "Failed to query WDS latest snapshots"
        return 1
    fi
    log_debug "$image_volume_id" "wds_get_image_snapshot: latest snapshots response=$latest_ret"
    code=$(jq -r '.code' <<< "$latest_ret")
    if [ "$code" != "000000" ]; then
        log_debug "$image_volume_id" "Invalid WDS latest snapshot response"
        return 1
    fi
    latest_snapshots=$(jq -c '.data.list.snaps' <<< "$latest_ret")
    # WDS returns a null list when the snapshot count is zero.
    if [ "$(jq -r '.data.totalCount' <<< "$latest_ret")" = "0" ]; then
        latest_snapshots='[]'
    fi

    # If there are no snapshots, the first entry is null.
    latest_snapshot=$(jq -c '.[0]' <<< "$latest_snapshots")
    latest_name=$(jq -r '.show_vol_name' <<< "$latest_snapshot")
    log_debug "$image_volume_id" "wds_get_image_snapshot: first snapshot name=$latest_name"
    if [ "$latest_name" = "$image_prefix" ]; then
        log_debug "$image_volume_id" "wds_get_image_snapshot: first entry matches source volume, using second entry"
        latest_snapshot=$(jq -c '.[1]' <<< "$latest_snapshots")
        latest_name=$(jq -r '.show_vol_name' <<< "$latest_snapshot")
    fi

    # 2. Reuse the numbered snapshot until its real clone count reaches 96.
    local latest_id relation_ret count
    local sequence=1
    local create_snapshot=false
    if [ "$latest_snapshot" = null ]; then
        log_debug "$image_volume_id" "wds_get_image_snapshot: no numbered snapshot, creating sequence=1"
        create_snapshot=true
    else
        sequence=${latest_name##*-}
        latest_id=$(jq -r '.id' <<< "$latest_snapshot")
        log_debug "$image_volume_id" "wds_get_image_snapshot: selected snapshot id=$latest_id name=$latest_name sequence=$sequence"
        if ! relation_ret=$(wds_curl_v3 GET "manager/block/v3/snap/$latest_id/relation_tree?current_page=0&page_size=1"); then
            log_debug "$image_volume_id" "Failed to query WDS snapshot relations"
            return 1
        fi
        log_debug "$image_volume_id" "wds_get_image_snapshot: relation response=$relation_ret"
        code=$(jq -r '.code' <<< "$relation_ret")
        if [ "$code" != "000000" ]; then
            log_debug "$image_volume_id" "Invalid WDS snapshot relation response"
            return 1
        fi
        count=$(jq -r '.data.totalCount' <<< "$relation_ret")
        if [ -z "$count" ] || [ "$count" = null ]; then
            log_debug "$image_volume_id" "Missing WDS snapshot relation count"
            return 1
        fi
        log_debug "$image_volume_id" "wds_get_image_snapshot: clone count=$count threshold=96 snapshot_id=$latest_id"
        if [ "$count" -ge 96 ]; then
            sequence=$((sequence + 1))
            create_snapshot=true
            log_debug "$image_volume_id" "wds_get_image_snapshot: threshold reached, next sequence=$sequence"
        fi
    fi

    # 3. Create directly when needed, without an existence query.
    local snapshot_name create_ret ret_code
    snapshot_name=$image_prefix-$sequence
    log_debug "$image_volume_id" "wds_get_image_snapshot: decision name=$snapshot_name sequence=$sequence create_snapshot=$create_snapshot"
    if [ "$create_snapshot" = true ]; then
        create_ret=$(wds_curl POST "api/v2/sync/block/snaps" "{\"name\": \"$snapshot_name\", \"description\": \"$snapshot_name\", \"volume_id\": \"$image_volume_id\"}")
        log_debug "$image_volume_id" "wds_get_image_snapshot: create response=$create_ret"
        ret_code=$(jq -r '.ret_code' <<< "$create_ret")
        if [ "$ret_code" != "0" ]; then
            log_debug "$image_volume_id" "Failed to create WDS image snapshot: $snapshot_name"
            return 1
        fi
    fi

    # 4. Resolve both reused and new snapshots with one common exact-name query.
    local snapshot_ret snapshot_id snap_size
    log_debug "$image_volume_id" "wds_get_image_snapshot: exact lookup name=$snapshot_name"
    snapshot_ret=$(wds_curl GET "api/v2/sync/block/snaps?name=$snapshot_name" '{}')
    log_debug "$image_volume_id" "wds_get_image_snapshot: exact lookup response=$snapshot_ret"
    ret_code=$(jq -r '.ret_code' <<< "$snapshot_ret")
    if [ "$ret_code" != "0" ]; then
        log_debug "$image_volume_id" "Invalid WDS exact snapshot response"
        return 1
    fi
    snapshot_id=$(jq -r '.snaps[0].id' <<< "$snapshot_ret")
    if [ -z "$snapshot_id" ] || [ "$snapshot_id" = null ]; then
        log_debug "$image_volume_id" "Missing WDS clone snapshot: $snapshot_name"
        return 1
    fi
    snapshot_name=$(jq -r '.snaps[0].name' <<< "$snapshot_ret")
    snap_size=$(jq -r '.snaps[0].snap_size' <<< "$snapshot_ret")
    log_debug "$image_volume_id" "wds_get_image_snapshot: result snapshot_id=$snapshot_id name=$snapshot_name sequence=$sequence snap_size=$snap_size"

    # 5. Output the JSON result for callers using result=$(wds_get_image_snapshot ...).
    jq -cn --arg id "$snapshot_id" --arg name "$snapshot_name" \
        --argjson sequence "$sequence" --argjson size "$snap_size" \
        '{snapshot_id:$id,snapshot_name:$name,snapshot_sequence:$sequence,snap_size:$size}'
}

# Select pool with lowest usage (real_data_size/valid_size) from comma-separated list.
# Skips pools with valid_size=0 or API failure; fallback to first pool if none valid.
# Usage: pool_ID=$(select_pool_lowest_usage "id1, id2, id3")
function select_pool_lowest_usage()
{
    local pool_list="$1"
    local first_pool=""
    local best_pool=""
    local best_ratio=""
    local pid

    IFS=',' read -ra arr <<< "$pool_list"
    for pid in "${arr[@]}"; do
        pid=$(echo "$pid" | xargs)
        [ -z "$pid" ] && continue
        [ -z "$first_pool" ] && first_pool="$pid"

        local resp
        resp=$(wds_curl GET "api/v2/failure_domain/$pid")
        local ret_code
        ret_code=$(echo "$resp" | jq -r '.ret_code')
        [ "$ret_code" != "0" ] && continue

        local real_data_size valid_size
        real_data_size=$(echo "$resp" | jq -r '.members.real_data_size')
        valid_size=$(echo "$resp" | jq -r '.members.valid_size')

        [ "$valid_size" = "null" ] && continue
        [ -z "$valid_size" ] && continue
        [ "$valid_size" = "0" ] && continue

        local ratio
        ratio=$(echo "$real_data_size" "$valid_size" | awk 'BEGIN{OFMT="%.10f"} {print $1/$2}')

        if [ -z "$best_pool" ]; then
            best_pool="$pid"
            best_ratio="$ratio"
        else
            local is_better
            is_better=$(echo "$ratio $best_ratio" | awk '{if($1<$2) print "1"; else print "0"}')
            [ "$is_better" = "1" ] && best_pool="$pid" && best_ratio="$ratio"
        fi
    done

    if [ -n "$best_pool" ]; then
        echo "$best_pool"
    else
        echo "$first_pool"
    fi
}

function get_uss_gateway()
{
    uss_hname=$1
    [ -z "$uss_hname" ] && uss_hname=$(hostname -s)
    uss_id=$(wds_curl GET "api/v2/wds/uss" | jq --arg hname $uss_hname -r '.uss_gateways | .[] | select(.server_name == $hname) | .id')
    [ -n "$uss_id" ] && echo $uss_id
}

function delete_vhost()
{
    [ $# -lt 2 ] && return
    local vol_ID=$1
    local vhost_id=$2
    local uss_unbinded="true"
    local uss_id
    [ $# -eq 3 ] && uss_id=$3 && uss_unbinded="false"

    if [ "$uss_unbinded" == "false" ]; then
        # add retry logic
        local i
        for i in {1..5}; do
            log_debug $vol_ID "Attempting to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id"
            local unbind_ret=$(wds_curl PUT "api/v2/sync/block/vhost/unbind_uss" "{\"vhost_id\": \"$vhost_id\", \"uss_gw_id\": \"$uss_id\", \"is_snapshot\": false}")
            local ret_code=$(echo $unbind_ret | jq -r '.ret_code')
            if [ "$ret_code" == "0" ]; then
                log_debug $vol_ID "Successfully unbound volume($vol_ID)'s vhost $vhost_id from uss $uss_id"
                uss_unbinded="true"
                break
            else
                local err_message=$(echo $unbind_ret | jq -r '.message')
                log_debug $vol_ID "Failed to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id, error message: $err_message"
            fi
            sleep 1
        done
    fi
    if [ "$uss_unbinded" == "true" ]; then
        local vhost_deleted="false"
        log_debug $vol_ID "Proceeding to delete volume($vol_ID)'s vhost $vhost_id"
        local i
        for i in {1..5}; do
            local delete_ret=$(wds_curl DELETE "api/v2/sync/block/vhost/$vhost_id")
            local ret_code=$(echo $delete_ret | jq -r '.ret_code')
            if [ "$ret_code" == "0" ]; then
                log_debug $vol_ID "Successfully deleted volume($vol_ID)'s vhost $vhost_id"
                vhost_deleted="true"
                break
            else
                local err_message=$(echo $delete_ret | jq -r '.message')
                log_debug $vol_ID "Failed to delete volume($vol_ID)'s vhost $vhost_id, error message: $err_message"
            fi
            sleep 1
        done
        if [ "$vhost_deleted" == "true" ]; then
            log_debug $vol_ID "Successfully deleted volume($vol_ID)'s vhost $vhost_id"
        else
            log_debug $vol_ID "Failed to delete volume($vol_ID)'s vhost $vhost_id after multiple attempts"
        fi
    else
        log_debug $vol_ID "Failed to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id after multiple attempts; skipping deletion of vhost"
    fi
}

function async_exec()
{
    exec 3<&0
    mkdir -p $async_job_dir
    (
        delayed_log=$async_job_dir/$(date +%s.%N)
        exec 0<&3
        exec >${delayed_log}.in_progress 2>&1
        $*
        mv ${delayed_log}.in_progress ${delayed_log}.done
    ) &
    exec 3<&-
}

function log_debug()
{
    # check if parameter count less than 2
    [ $# -lt 2 ] && return
    local vm_ID=$1
    shift
    # check if debug file exists
    if [ -f $debug_flag_file ]; then
        # write log and timestamp to debug log file
        echo "[$(date -u +%Y%m%d%H%M%S)] $vm_ID $*" >> $debug_log_file
    fi
}

function inet_access()
{
    mkdir -p /etc/netns/router-0
    echo "nameserver $dns_server" >/etc/netns/router-0/resolv.conf
    ip netns exec router-0 iptables -D INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
    ip netns exec router-0 iptables -A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
    ip netns exec router-0 $*
    ip netns exec router-0 iptables -D INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
}

function get_uuid_prefix()
{
    [ $# -lt 1 ] && return
    uuid=$1
    prefix=${uuid%%-*}
    echo "$prefix"
}

function wait_qemu_ping()
{
    vm_ID=inst-$1
    num=$2
    [ -z "$num" ] && num=0
    count=0
    for i in {1..240}; do
        virsh qemu-agent-command "$vm_ID" '{"execute":"guest-ping"}'
        if [ $? -eq 0 ]; then
            let count=$count+1
        fi
        [ $count -gt $num ] && break
        sleep 5
    done
}

function sync_vm()
{
    ID=$1
    sed -i "/$1/d" $image_dir/old_inst_list
}

function get_next_disk_target()
{
    local vm_ID=$1
    local used
    local dev
    local next_dev
    local letter

    used=$(virsh domblklist "$vm_ID" --details | awk '$2=="disk" {print $3}' | grep '^vd')

    for letter in {b..z}; do
        dev="vd${letter}"
        if ! echo "$used" | grep -q "^${dev}$"; then
            next_dev=$dev
            break
        fi
    done
    log_debug $vm_ID "Next available disk target: $next_dev"
    echo "$next_dev"
}
