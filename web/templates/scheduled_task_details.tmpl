{{template "_head" .}}
<div class="admin user">
    <div class="ui container">
        <div class="ui grid">
            {{template "_left" .}}
            <div class="user signup">
                <div class="ui middle very relaxed page grid">
                    <div class="">
                        <form class="ui form">
                            <h3 class="ui top attached header">
                                {{.i18n.Tr "Scheduled Task"}}
                            </h3>
                            <div class="ui attached segment">
                                <div class="inline field">
                                    <label for="name">{{.i18n.Tr "Name"}}</label>
                                    <input id="name" value="{{.Task.Name}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="task_type">{{.i18n.Tr "Task Type"}}</label>
                                    <input id="task_type" value="{{.Task.TaskType}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="resource_type">{{.i18n.Tr "Resource Type"}}</label>
                                    <input id="resource_type" value="{{.Task.ResourceType}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="resource_id">{{.i18n.Tr "Resource ID"}}</label>
                                    <input id="resource_id" value="{{.Task.ResourceID}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="operation">{{.i18n.Tr "Operation"}}</label>
                                    <input id="operation" value="{{.Task.Operation}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="schedule_type">{{.i18n.Tr "Schedule Type"}}</label>
                                    <input id="schedule_type" value="{{.Task.ScheduleType}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="execution_time">{{.i18n.Tr "Execution Time"}}</label>
                                    <input id="execution_time" value="{{if not .Task.ExecutionTime.IsZero}}{{.Task.ExecutionTime.Format "2006-01-02 15:04:05"}}{{end}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="cron_expression">{{.i18n.Tr "Cron Expression"}}</label>
                                    <input id="cron_expression" value="{{.Task.CronExpression}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="retention_count">{{.i18n.Tr "Retention Count"}}</label>
                                    <input id="retention_count" value="{{.Task.RetentionCount}}" disabled>
                                </div>
                                <div class="inline field">
                                    <label for="status">{{.i18n.Tr "Status"}}</label>
                                    <input id="status" value="{{.Task.Status}}" disabled>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{template "_footer" .}}
