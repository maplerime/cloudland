<section id="suspicious-ips">
    <div class="ui attached segment">
        <p>{{.i18n.Tr "Suspicious_IP_Description"}}</p>
        <p>{{.i18n.Tr "Suspicious_IP_Delete_Hint"}}</p>
        <form class="ui form" method="get" action="/check_connection/suspicious">
            <input type="hidden" name="limit" value="{{.Limit}}">
            <div class="field"><label for="suspicious-ip">{{.i18n.Tr "IP"}}</label><input id="suspicious-ip" name="ip" value="{{.IP}}"></div>
            <button class="ui blue tiny button">{{.i18n.Tr "Search"}}</button>
            <a class="ui tiny button" href="/check_connection/suspicious">{{.i18n.Tr "Reset"}}</a>
        </form>
    </div>
    <div class="ui unstackable attached table segment"><table class="ui unstackable very basic striped table">
        <thead><tr><th>{{.i18n.Tr "IP"}}</th><th>{{.i18n.Tr "Suspicious_IP_Note"}}</th><th>{{.i18n.Tr "Suspicious_IP_LastSeenAt"}}</th><th>{{.i18n.Tr "Compute_Node"}}</th><th>{{.i18n.Tr "BlockedAt"}}</th><th>{{.i18n.Tr "Suspicious_IP_BlockError"}}</th><th>{{.i18n.Tr "Actions"}}</th></tr></thead>
        <tbody>{{range .Entries}}<tr>
            <td>{{.IP}}</td><td>{{.Note}}</td>
            <td>{{if .LastSeenAt}}{{.LastSeenAt.Format "2006-01-02 15:04:05 UTC"}}{{end}}</td><td>{{if .LastSeenNode}}{{.LastSeenNode}}{{end}}</td>
            <td>{{if .BlockedAt}}{{.BlockedAt.Format "2006-01-02 15:04:05 UTC"}}{{end}}</td><td>{{.BlockError}}</td>
            <td>
                <a class="ui tiny button" href="/check_connection/suspicious/{{.UUID}}/edit">{{$.i18n.Tr "Edit"}}</a>
                <form style="display:inline" action="/check_connection/suspicious/{{.UUID}}/block" method="post"><button class="ui orange tiny button">{{$.i18n.Tr "Suspicious_IP_Block"}}</button></form>
                <form style="display:inline" action="/check_connection/suspicious/{{.UUID}}/delete" method="post"><button class="ui red tiny button">{{$.i18n.Tr "Delete"}}</button></form>
            </td>
        </tr>{{else}}<tr><td colspan="7">{{.i18n.Tr "Suspicious_IP_Empty"}}</td></tr>{{end}}</tbody>
    </table></div>
</section>
