{{template "_head" .}}
<div class="admin user">
    <div class="ui container">
        <div class="ui grid">
            {{template "_left" .}}
            <div class="twelve wide column content">
                <h4 class="ui top attached header">{{.i18n.Tr "VM_Record_Detail"}}</h4>
                <div class="ui attached segment">
                    <h5>{{.i18n.Tr "VM_Collection_Result"}}</h5>
                    {{if .Inspection}}
                    <p>{{.i18n.Tr (printf "VM_Collection_%s" .Inspection.collection_status)}}
                         · {{call .DisplayTime .Record.CollectedAt}}</p>
                    <p>Guest Agent: {{call .Display .Inspection.agent.status}} · {{call .DisplayError .Inspection.agent.status .Inspection.agent.error_message}}</p>
                    <h5>{{.i18n.Tr "VM_Processes"}}</h5>
                    <p>{{.i18n.Tr "VM_Process_CPU_Basis"}}</p>
                    <table class="ui compact striped table">
                        <thead><tr><th>{{.i18n.Tr "Username"}}</th><th>PID</th><th>CPU %</th><th>{{.i18n.Tr "Name"}}</th></tr></thead>
                        <tbody>{{range .Inspection.cputop_processes.items}}
                            <tr><td>{{call $.Display .user}}</td><td>{{call $.Display .pid}}</td><td>{{call $.Display .cpu_percent}}</td><td style="overflow-wrap:anywhere">{{call $.Display .name}}</td></tr>
                        {{else}}<tr><td colspan="4">NA</td></tr>{{end}}</tbody>
                    </table>
                    <p>{{call .Display .Inspection.cputop_processes.status}} · {{call .DisplayTime .Inspection.cputop_processes.collected_at}} · {{call .DisplayError .Inspection.cputop_processes.status .Inspection.cputop_processes.error_message}}</p>
                    <h5>{{.i18n.Tr "VM_File_Observations"}}</h5>
                    {{$cupsd := .Inspection.required_check.cupsd}}
                    <p>{{call .Display $cupsd.status}} · {{call .DisplayError $cupsd.status $cupsd.error_message}}</p>
                    <table class="ui compact definition table"><tbody>
                        {{range $name,$value := $cupsd}}
                        {{if and (ne $name "status") (ne $name "error_message")}}
                        <tr><td>{{$.i18n.Tr (printf "VM_Check_%s" $name)}}</td><td>{{if or (eq $name "binary_mtime") (eq $name "keepalive_mtime")}}{{call $.DisplayTime $value}}{{else}}{{call $.Display $value}}{{end}}</td></tr>
                        {{end}}
                        {{else}}<tr><td>NA</td></tr>{{end}}
                    </tbody></table>
                    <h5>WDS</h5>
                    <table class="ui compact striped table">
                        <thead><tr><th>{{.i18n.Tr "Name"}}</th><th>{{.i18n.Tr "Cpu"}}</th></tr></thead>
                        <tbody>{{range .Inspection.wds.gateways}}<tr><td>{{call $.Display .name}}</td><td>{{range .core_cpus}}{{.}} {{else}}NA{{end}}</td></tr>
                        {{else}}<tr><td colspan="2">NA</td></tr>{{end}}</tbody>
                    </table>
                    <p>{{call .Display .Inspection.wds.status}} · {{call .DisplayError .Inspection.wds.status .Inspection.wds.error_message}}</p>
                    {{else}}<p>NA</p>{{end}}
                    <table class="ui definition table" style="overflow-wrap:anywhere">
                        <tbody>
                            <tr><td>{{.i18n.Tr "UUID"}}</td><td>{{.Record.UUID}}</td></tr>
                            <tr><td>{{.i18n.Tr "InstanceUUID"}}</td><td>{{.Record.InstanceUUID}}</td></tr>
                            <tr><td>{{.i18n.Tr "Compute_Node"}}</td><td>{{call .Display .Record.HyperHostname}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Verdict"}}</td><td>{{if .Record.Verdict}}{{.i18n.Tr (printf "VM_Verdict_%s" .Record.Verdict)}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Ruleset_Version"}}</td><td>{{if .Record.RulesetVersion}}{{call .Display .Record.RulesetVersion}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Match_Summary"}}</td><td>{{if .Record.MatchSummary}}{{call .Display .Record.MatchSummary}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Match_Rules"}}</td><td>{{range .MatchRules}}<div>{{.}}</div>{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Isolation_Status"}}</td><td>{{if .Record.IsolationStatus}}{{.i18n.Tr (printf "VM_Status_%s" .Record.IsolationStatus)}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Isolation_CPUs"}}</td><td>{{call .Display .Record.IsolationCPUs}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Isolation_Source"}}</td><td>{{if .Record.IsolationSource}}{{.i18n.Tr (printf "VM_Source_%s" .Record.IsolationSource)}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Isolation_Operation_Time"}} (UTC)</td><td>{{if and .Record.IsolationStatus (ne .Record.IsolationStatus "disabled") (ne .Record.IsolationStatus "not_requested")}}{{call .DisplayTime .Record.OperationAt}}{{else}}NA{{end}}</td></tr>
                            <tr><td>{{.i18n.Tr "Created_At"}} (UTC)</td><td>{{call .DisplayTime .Record.CreatedAt}}</td></tr>
                            <tr><td>{{.i18n.Tr "Updated_At"}} (UTC)</td><td>{{call .DisplayTime .Record.UpdatedAt}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Scan_ID"}}</td><td>{{call .Display .Record.ScanID}}</td></tr>
                            <tr><td>{{.i18n.Tr "VM_Operation_Reason"}}</td><td style="white-space:pre-wrap">{{call .Display .Record.Remark}}</td></tr>
                            <tr><td>{{.i18n.Tr "Error"}}</td><td style="white-space:pre-wrap">{{call .DisplayError .Record.IsolationStatus .Record.ErrorMessage}}</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="ui attached segment">
                    <form class="ui form" method="post" action="/vm-infections/action" data-confirm="{{.i18n.Tr "VM_Action_Confirm"}}">
                        <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
                        <input type="hidden" name="instance_uuid" value="{{.Record.InstanceUUID}}">
                        <input type="hidden" name="record_uuid" value="{{.Record.UUID}}">
                        <input type="hidden" name="action" value="{{if .NeedsRestore}}release{{else}}quarantine{{end}}">
                        <div class="required field"><label for="reason">{{.i18n.Tr "VM_Operation_Reason"}}</label><textarea id="reason" name="reason" rows="2" maxlength="255" required></textarea></div>
                        <button class="ui orange button" type="submit">{{if .NeedsRestore}}{{.i18n.Tr "VM_Release"}}{{else}}{{.i18n.Tr "VM_Quarantine"}}{{end}}</button>
                    </form>
                </div>
                <div class="ui bottom attached segment">
                    {{if .NeedsRestore}}<p>{{.i18n.Tr "VM_Delete_Protected"}}</p>{{else}}
                    <form method="post" action="/vm-infections/{{.Record.UUID}}/delete" data-confirm="{{.i18n.Tr "VM_Delete_Confirm"}}">
                        <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
                        <button class="ui red basic button" type="submit">{{.i18n.Tr "Delete"}}</button>
                    </form>
                    {{end}}
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/vm_inspection.js"></script>
{{template "_footer" .}}
