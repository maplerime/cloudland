{{template "_head" .}}
<div class="admin user"><div class="ui container"><div class="ui grid">
    {{template "_left" .}}
    <div class="twelve wide column content">
        <h4 class="ui top attached header">{{.i18n.Tr "Blocked_IP_Manage_Panel"}} ({{.i18n.Tr "Total"}}: {{.Total}})
            <div class="ui right"><a class="ui green tiny button" href="/blocked-ips/suspicious/new">{{.i18n.Tr "Create"}}</a></div>
        </h4>
        {{template "_blocked_ip_tabs" .}}
        <div class="ui attached segment">
            <p>{{.i18n.Tr "Suspicious_IP_Description"}}</p>
            <p>{{.i18n.Tr "Suspicious_IP_Delete_Hint"}}</p>
            <form class="ui form" method="get">
                <div class="two fields">
                    <div class="field"><label for="ip">{{.i18n.Tr "IP"}}</label><input id="ip" name="ip" value="{{.IP}}"></div>
                    <div class="field"><label for="status">{{.i18n.Tr "Status"}}</label>
                        <select id="status" name="status">
                            <option value="">{{.i18n.Tr "Suspicious_IP_All_Statuses"}}</option>
                            <option value="suspicious" {{if eq .Status "suspicious"}}selected{{end}}>{{.i18n.Tr "Suspicious_IP_Status_suspicious"}}</option>
                            <option value="blocked" {{if eq .Status "blocked"}}selected{{end}}>{{.i18n.Tr "Suspicious_IP_Status_blocked"}}</option>
                            <option value="block_failed" {{if eq .Status "block_failed"}}selected{{end}}>{{.i18n.Tr "Suspicious_IP_Status_block_failed"}}</option>
                        </select>
                    </div>
                </div>
                <button class="ui blue tiny button">{{.i18n.Tr "Search"}}</button>
                <a class="ui tiny button" href="/blocked-ips/suspicious">{{.i18n.Tr "Reset"}}</a>
            </form>
        </div>
        <div class="ui unstackable attached table segment"><table class="ui unstackable very basic striped table">
            <thead><tr><th>{{.i18n.Tr "IP"}}</th><th>{{.i18n.Tr "Status"}}</th><th>{{.i18n.Tr "Suspicious_IP_Note"}}</th><th>{{.i18n.Tr "Suspicious_IP_LastSeenAt"}}</th><th>{{.i18n.Tr "Compute_Node"}}</th><th>{{.i18n.Tr "BlockedAt"}}</th><th>{{.i18n.Tr "Suspicious_IP_BlockError"}}</th><th>{{.i18n.Tr "Actions"}}</th></tr></thead>
            <tbody>{{range .Entries}}<tr>
                <td>{{.IP}}</td><td>{{$.i18n.Tr (printf "Suspicious_IP_Status_%s" .Status)}}</td><td>{{.Note}}</td>
                <td>{{if .LastSeenAt}}{{.LastSeenAt.Format "2006-01-02 15:04:05 UTC"}}{{end}}</td><td>{{if .LastSeenNode}}{{.LastSeenNode}}{{end}}</td>
                <td>{{if .BlockedAt}}{{.BlockedAt.Format "2006-01-02 15:04:05 UTC"}}{{end}}</td><td>{{.BlockError}}</td>
                <td>
                    <a class="ui tiny button" href="/blocked-ips/suspicious/{{.UUID}}/edit">{{$.i18n.Tr "Edit"}}</a>
                    <form style="display:inline" action="/blocked-ips/suspicious/{{.UUID}}/block" method="post"><button class="ui orange tiny button">{{$.i18n.Tr "Suspicious_IP_Block"}}</button></form>
                    <form style="display:inline" action="/blocked-ips/suspicious/{{.UUID}}/delete" method="post"><button class="ui red tiny button">{{$.i18n.Tr "Delete"}}</button></form>
                </td>
            </tr>{{else}}<tr><td colspan="8">{{.i18n.Tr "Suspicious_IP_Empty"}}</td></tr>{{end}}</tbody>
        </table></div>
        {{template "_pagination" .}}
    </div>
</div></div></div>
{{template "_footer" .}}
