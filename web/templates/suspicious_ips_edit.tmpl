{{template "_head" .}}
<div class="admin user"><div class="ui container"><div class="ui grid">
    {{template "_left" .}}
    <div class="twelve wide column content">
        <h4 class="ui top attached header"><a href="/check_connection">{{.i18n.Tr "Check_Connection"}}</a> / {{.i18n.Tr "Suspicious_IPs"}}</h4>
        {{template "_check_connection_tabs" .}}
        <div class="ui attached segment">
            <form class="ui form" action="{{.Link}}" method="post">
                <div class="required field"><label for="ip">{{.i18n.Tr "IP"}}</label>
                    <input id="ip" name="ip" required value="{{if .Entry}}{{.Entry.IP}}{{end}}" {{if .Entry}}{{if eq .Entry.Status "blocked"}}readonly{{end}}{{end}}>
                </div>
                <div class="field"><label for="note">{{.i18n.Tr "Suspicious_IP_Note"}}</label><textarea id="note" name="note" maxlength="4096" rows="3">{{if .Entry}}{{.Entry.Note}}{{end}}</textarea></div>
                <p>{{.i18n.Tr "Suspicious_IP_Delete_Hint"}}</p>
                <button class="ui green button">{{.i18n.Tr "Suspicious_IP_Save"}}</button>
                <a class="ui button" href="/check_connection/suspicious">{{.i18n.Tr "Cancel"}}</a>
            </form>
        </div>
    </div>
</div></div></div>
{{template "_footer" .}}
