{{template "_head" .}}
<div class="admin user">
    <div class="ui container">
        <div class="ui grid">
        {{template "_left" .}}
            <div class="user signup">
                <div class="ui middle very relaxed page grid">
                    <div class="">
                        <form class="ui form" action="{{.Link}}" method="post">
                            <h3 class="ui top attached header">
                                {{.i18n.Tr "Export Image"}}: {{.Image.Name}}
                            </h3>
                            <div class="ui attached segment">
                                <div class="required inline field">
                                    <label for="storage_id">{{.i18n.Tr "Storage Pool"}}</label>
                                    <div class="ui selection dropdown">
                                        <input id="storage_id" name="storage_id" type="hidden">
                                        <i class="dropdown icon"></i>
                                        <div class="default text">{{.i18n.Tr "Select Storage Pool"}}</div>
                                        <div class="menu">
                                            {{ range .Storages }}
                                            <div class="item" data-value="{{.ID}}" data-text="{{.PoolID}}">
                                                {{.PoolID}} ({{.Status}})
                                            </div>
                                            {{ end }}
                                        </div>
                                    </div>
                                </div>
                                <div class="inline field">
                                    <label></label>
                                    <button class="ui green button">{{.i18n.Tr "Start Export"}}</button>
                                    <a class="ui button" href="/images">{{.i18n.Tr "Cancel"}}</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{template "_footer" .}}
