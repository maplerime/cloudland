{{template "_head" .}}
    <div class="admin user">
        <div class="ui container">
            <div class="ui grid">
                {{template "_left" .}}
                <div class="twelve wide column content">
                    <h4 class="ui top attached header">
                        {{.i18n.Tr "Traffic_Billing_Manage_Panel"}} ({{.i18n.Tr "Total"}}: {{.Total}})
                        <div class="ui right">
                            {{template "_column_selector" .}}
                            <a class="ui green tiny button" href="traffic-billing/new">{{.i18n.Tr "Create"}}</a>
                            <button class="ui blue tiny button" id="refresh-billing-btn" onclick="refreshTrafficBilling(event)">{{.i18n.Tr "Refresh"}}</button>
                            <button class="ui teal tiny button" id="sync-nic-meta-btn" onclick="syncNicMeta(event)" title="Push each nic's north-south mark to the compute nodes, so a multi-nic instance's private nic stops being billed as north-south traffic. Run after upgrading clapi.">Sync NIC Meta</button>
                        </div>
                    </h4>
                    <div class="ui attached segment">
                        <form class="ui form">
                            <div class="ui fluid tiny action input">
                                <input name="q" value="{{ .Query }}" placeholder="Search Instance UUID..." autofocus>
                                <button class="ui blue tiny button">{{.i18n.Tr "Search"}}</button>
                            </div>
                        </form>
                    </div>
                    <div class="ui unstackable attached table segment">
                        <table class="ui unstackable very basic striped table">
                            <thead>
                                <tr>
                                    <th data-column="ID">{{.i18n.Tr "ID"}}</th>
                                    <th data-column="UUID">{{.i18n.Tr "UUID"}}</th>
                                    <th data-column="InstanceUUID">{{.i18n.Tr "InstanceUUID"}}</th>
                                    <th data-column="CreatedAt">{{.i18n.Tr "CreatedAt"}}</th>
                                    <th data-column="Delete">{{.i18n.Tr "Delete"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{ $Link := .Link }}
                                {{ range .TrafficBillings }}
                                <tr>
                                    <td data-column="ID">{{.ID}}</td>
                                    <td data-column="UUID">{{.UUID}}</td>
                                    <td data-column="InstanceUUID">{{.InstanceUUID}}</td>
                                    <td data-column="CreatedAt">{{.CreatedAt}}</td>
                                    <td data-column="Delete"><div class="delete-button" data-url="{{$Link}}/{{.InstanceUUID}}" data-id="{{.UUID}}"><i class="dark purple trash alternate outline icon"></i></div></td>
                                </tr>
                                {{ end }}
                            </tbody>
                        </table>
                    </div>
                    {{template "_pagination" .}}
                </div>
            </div>
        </div>
    </div>
    <div class="ui small basic delete modal">
        <div class="ui icon header">
            <i class="trash icon"></i>
            {{.i18n.Tr "Traffic Billing Mark Deletion"}}
        </div>
        <div class="content">
            <p>{{.i18n.Tr "Traffic_Billing_Deletion_Confirm"}}</p>
        </div>
        {{template "_delete_modal_actions" .}}
    </div>
<script>
function refreshTrafficBilling(e) {
    e.preventDefault();
    var btn = document.getElementById('refresh-billing-btn');
    btn.classList.add('loading', 'disabled');
    fetch('traffic-billing/refresh', {
        method: 'POST',
        credentials: 'same-origin'
    }).then(function(r) {
        return r.json();
    }).then(function(data) {
        btn.classList.remove('loading', 'disabled');
        if (data.error) {
            alert('Refresh failed: ' + data.error);
        } else {
            alert('Refresh broadcast to all compute nodes. It may take a few seconds for each node to rebuild its local metric file.');
            window.location.reload();
        }
    }).catch(function(err) {
        btn.classList.remove('loading', 'disabled');
        alert('Refresh failed: ' + err);
    });
}

// Only multi-nic instances are dispatched -- a single-nic instance's only
// interface is necessarily its default route, which is what the metering script
// already assumes when the mark is absent -- so the counts reported back are
// deliberately far smaller than the instance total.
function syncNicMeta(e) {
    e.preventDefault();
    var btn = document.getElementById('sync-nic-meta-btn');
    btn.classList.add('loading', 'disabled');
    fetch('traffic-billing/nic-meta-sync', {
        method: 'POST',
        credentials: 'same-origin'
    }).then(function(r) {
        return r.json();
    }).then(function(data) {
        btn.classList.remove('loading', 'disabled');
        if (data.error) {
            alert('Sync NIC meta failed: ' + data.error);
        } else {
            alert('NIC meta sync dispatched to ' + data.nodes + ' node(s): '
                + data.nics + ' nic(s) on ' + data.instances + ' multi-nic instance(s).\n'
                + 'Each node rewrites its own files; the metrics follow on the next 5-minute collection.');
        }
    }).catch(function(err) {
        btn.classList.remove('loading', 'disabled');
        alert('Sync NIC meta failed: ' + err);
    });
}
</script>
{{template "_footer" .}}
