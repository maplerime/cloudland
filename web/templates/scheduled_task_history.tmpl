{{template "_head" .}}
<div class="admin user">
    <div class="ui container">
        <div class="ui grid">
            {{template "_left" .}}
            <div class="twelve wide column content">
                <h4 class="ui top attached header">
                    {{.i18n.Tr "Scheduled Task History"}} ({{.i18n.Tr "Total"}}: {{.Total}})
                </h4>
                <div class="ui attached segment">
                    <table class="ui unstackable very basic striped table">
                        <thead>
                            <tr>
                                <th>{{.i18n.Tr "ID"}}</th>
                                <th>{{.i18n.Tr "Scheduled Task"}}</th>
                                <th>{{.i18n.Tr "Task UUID"}}</th>
                                <th>{{.i18n.Tr "Status"}}</th>
                                <th>{{.i18n.Tr "Message"}}</th>
                                <th>{{.i18n.Tr "Execution Time"}}</th>
                                <th>{{.i18n.Tr "Duration"}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .Histories}}
                            <tr>
                                <td>{{.ID}}</td>
                                <td>
                                    {{if .ScheduledTask}}
                                        {{if .ScheduledTask.DeletedAt}}
                                            {{if .ScheduledTask.Name}}{{.ScheduledTask.Name}} (deleted){{else}}Deleted Task #{{.ScheduledTaskID}}{{end}}
                                        {{else}}
                                            <a href="/scheduled_tasks/{{.ScheduledTaskID}}/view">{{.ScheduledTask.Name}}</a>
                                        {{end}}
                                    {{else}}
                                        Deleted Task #{{.ScheduledTaskID}}
                                    {{end}}
                                </td>
                                <td>{{if .ScheduledTask}}{{.ScheduledTask.UUID}}{{end}}</td>
                                <td>{{.Status}}</td>
                                <td>{{.Message}}</td>
                                <td data-utc="{{.ExecutionTime.UTC.Format "2006-01-02T15:04:05Z"}}">{{.ExecutionTime.Format "2006-01-02 15:04:05"}}</td>
                                <td>{{.Duration}}s</td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
                <div class="ui attached segment">
                    {{template "_pagination" .}}
                </div>
            </div>
        </div>
    </div>
</div>
{{template "_footer" .}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('td[data-utc]').forEach(function(td) {
        var d = new Date(td.dataset.utc);
        if (!isNaN(d.getTime())) {
            var p = function(v) { return String(v).padStart(2, '0'); };
            td.textContent = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) +
                ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
        }
    });
});
</script>
