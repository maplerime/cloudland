{{template "_head" .}}
    <div class="admin user">
        <div class="ui container">
            <div class="ui grid">
                {{template "_left" .}}
                <div class="twelve wide column content">
                    <h4 class="ui top attached header">
                        {{.i18n.Tr "API_Key_Manage_Panel"}} ({{.i18n.Tr "Total"}}: {{.Total}})
                        <div class="ui right">
                            {{template "_column_selector" .}}
                            <a class="ui green tiny button" href="api_keys/new">{{.i18n.Tr "Create"}}</a>
                        </div>
                    </h4>
                    <div class="ui attached segment">
                        <form class="ui form">
                            <div class="ui fluid tiny action input">
                                <input name="q" value="{{ .Query }}" placeholder="Search..." autofocus>
                                <button class="ui blue tiny button">{{.i18n.Tr "Search"}}</button>
                            </div>
                        </form>
                    </div>
                    <div class="ui unstackable attached table segment">
                        <table class="ui unstackable very basic striped table">
                            <thead>
                                <tr>
                                    <th data-column="UUID">{{.i18n.Tr "UUID"}}</th>
                                    <th data-column="Name">{{.i18n.Tr "Name"}}</th>
                                    <th data-column="ExpiresAt">{{.i18n.Tr "Expires_At"}}</th>
                                    <th data-column="Disabled">{{.i18n.Tr "Disabled"}}</th>
                                    <th data-column="CreatedAt">{{.i18n.Tr "Created_At"}}</th>
                                    {{ if .IsAdmin }}
                                    <th data-column="Owner">{{.i18n.Tr "Owner"}}</th>
                                    {{ end }}
                                    <th data-column="Action">{{.i18n.Tr "Action"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{ $Link := .Link }}
                                {{ range .APIKeys }}
                                <tr>
                                    <td data-column="UUID">{{.UUID}}</td>
                                    <td data-column="Name">{{.Name}}</td>
                                    <td data-column="ExpiresAt">{{ if .ExpiresAt }}<span title="{{.ExpiresAt}}">{{.ExpiresAt}}</span>{{ end }}</td>
                                    <td data-column="Disabled">{{ if .Disabled }}<span class="ui red tiny label">{{$.i18n.Tr "Disabled"}}</span>{{ else }}<span class="ui green tiny label">{{$.i18n.Tr "Enabled"}}</span>{{ end }}</td>
                                    <td data-column="CreatedAt"><span title="{{.CreatedAt}}">{{.CreatedAt}}</span></td>
                                    {{ if $.IsAdmin }}
                                    <td data-column="Owner">{{ if .OwnerInfo }}{{.OwnerInfo.Name}}{{ end }}</td>
                                    {{ end }}
                                    <td data-column="Action">
                                        <div class="ui selection dropdown">
                                            <input name="action" type="hidden">
                                            <i class="dropdown icon"></i>
                                            <div class="default text">Action</div>
                                            <div class="menu">
                                                <div class="item">
                                                    <a href="{{$Link}}/{{.UUID}}">{{$.i18n.Tr "Edit"}}</a>
                                                </div>
                                                <div class="item">
                                                    <a class="delete-button" data-url="{{$Link}}/{{.UUID}}" data-id="{{.UUID}}" href="javascript:void(0)">{{$.i18n.Tr "Delete"}}</a>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {{ end }}
                            </tbody>
                        </table>
                    </div>
                    <div class="ui attached segment">
                        {{template "_pagination" .}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="ui small basic delete modal">
        <div class="ui icon header">
            <i class="trash icon"></i>
            {{.i18n.Tr "API Key Deletion"}}
        </div>
        <div class="content">
            <p>{{.i18n.Tr "API_Key_Deletion_Confirm"}}</p>
        </div>
        {{template "_delete_modal_actions" .}}
    </div>
{{template "_footer" .}}
