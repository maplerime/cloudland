{{/* =========================================================
  丢包告警（packet_drop）
  原 Slack receiver：slack-drop-package
  原标题：PacketDropDetected on hostname by: description
  ========================================================= */}}
{{ define "teams.packet_drop.card" -}}
{
  "type": "message",
  "attachments": [{
    "contentType": "application/vnd.microsoft.card.adaptive",
    "contentUrl": null,
    "content": {
      "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
      "type": "AdaptiveCard",
      "version": "1.2",
      "msteams": {"width": "Full"},
      "body": [
        {
          "type": "TextBlock",
          "text": {{ printf "检测到丢包 | %s | %s" .CommonLabels.hostname .CommonLabels.description | toJson }},
          "weight": "Bolder",
          "size": "Medium",
          "color": "{{ if eq .Status "firing" }}Attention{{ else }}Good{{ end }}",
          "wrap": true
        },
        {
          "type": "FactSet",
          "facts": [
            {"title": "状态", "value": {{ .Status | toJson }}},
            {"title": "摘要", "value": {{ .CommonAnnotations.summary | toJson }}},
            {"title": "详细描述", "value": {{ .CommonLabels.description | toJson }}},
            {"title": "告警详情", "value": {{ .CommonAnnotations.description | toJson }}},
            {"title": "告警类型", "value": {{ .CommonLabels.alert_type | toJson }}},
            {"title": "级别", "value": {{ .CommonLabels.severity | toJson }}},
            {"title": "主机", "value": {{ .CommonLabels.hostname | toJson }}}
          ]
        }
      ]
    }
  }]
}
{{- end }}

{{/* =========================================================
  IP 组告警（ipgroup_low_ips）
  原 Slack receiver：slack-ipgroup-alerts
  原标题：IP Group ipgroup_name - Low Available IPs
