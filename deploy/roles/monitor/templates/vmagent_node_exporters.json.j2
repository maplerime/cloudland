[
{% set comma = joiner(',') %}
{% for host in groups['vmagent'] | default([]) %}
  {{ comma() }}
  {
    "targets": ["{{ hostvars[host].ansible_host | default(hostvars[host].ansible_ssh_host) | default(host) }}:{{ node_exporter_port | default(9101) }}"],
    "labels": {
      "host": "{{ host }}",
      "node_type": "vmagent"
    }
  }
{% endfor %}
]
